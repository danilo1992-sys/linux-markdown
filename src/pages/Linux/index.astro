---
import Vericalmenu from '../../components/Verticalmenu.astro'


import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const Linux = await getCollection('Linux');
---

<Layout title="Linux">
  <div class="flex mt-30 pl-5">
    <div class="w-fit mr-6 pt-18 sticky top-30 self-start">
      <Vericalmenu/>
    </div>
    <div class="flex-1 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-1 p-4 min-h-screen">
      {Linux.map((item) => (
      <a href={`/Linux/${item.id}`} class="block max-w-sm p-6 border border-default rounded-base shadow-xs bg-gray-900/60 backdrop-blur-md">
        <h5 class="mb-3 text-2xl font-semibold tracking-tight text-heading leading-8 text-white">{item.data.name}</h5>
          <p class="text-body text-white">{item.data.description}</p>
        </a>
      ))}
    </div>  
  </div>
</Layout>
