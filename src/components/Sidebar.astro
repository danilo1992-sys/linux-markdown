---
import Bash from './icons/Bash.astro'
import Search from './Search.astro'
import Repo from './Repo.astro'
---

<nav class="bg-gray-900 fixed w-full z-20 top-0 start-0 border-b border-gray-700">
  <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
    <a href="/" class="flex items-center space-x-3 rtl:space-x-reverse">
      <Bash width={28} height={28} />
      <span class="self-center text-xl font-semibold whitespace-nowrap text-white">Linux Commands</span>
    </a>
    <div class="flex items-center gap-4">
      <Search
        class="pagefind-ui"
        placeholder="Buscar Comando..."
        showImages={false}
        resetFilters={false}
        showSubResults={true}
        excerptLength={30}
      />
      <Repo />
    </div>
  </div>
</nav>
