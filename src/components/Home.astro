---

import Linux from './icons/Linux.astro'
import Hack from './icons/Hack.astro'
import Go from './icons/Go.astro'

const tags = {
  LINUX: {
    Icon: Linux
  },
   HACKING: {
    Icon: Hack 
  }, 
  GO: {
    Icon: Go
  }
}

const CARD = [
  { 
    title:"Linux",
    link:"/Linux",
    tags: [tags.LINUX]
  },
  { 
    title:"Ciberceguridad",
    link:"/Ciberceguridad",
    tags: [tags.HACKING]
  },
  { 
    title:"Go",
    link:"https://shimmering-cocada-715705.netlify.app/",
    external: true,
    tags: [tags.GO]
  }
] 

---

<div class="flex flex-wrap items-center justify-between mx-auto p-4">
<ul class="mt-30 ml-20 flex items-center space-x-3 rtl:space-x-reverse">
  {CARD.map(({ title, link, external, tags }) => (
  <li>
    <a href={link} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined} class="block max-w-sm p-6 border border-default rounded-base shadow-xs bg-gray-900/60 backdrop-blur-md">
      <div class="flex items-center gap-2">
        {tags.map((tag) => (
          <tag.Icon />
        ))}
        <h5 class="text-2xl font-semibold tracking-tight text-white leading-8">{title}</h5>
      </div>
    </a>
  </li>
  ))}
  </ul>
</div>
